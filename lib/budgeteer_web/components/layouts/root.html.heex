<!DOCTYPE html>
<html lang={if @locale == "pt_PT", do: "pt-PT", else: "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="theme-color" content="#1c1914" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="manifest" href={~p"/manifest.json"} />
    <link rel="apple-touch-icon" href={~p"/images/icons/apple-touch-icon.png"} />
    <link rel="icon" type="image/png" sizes="48x48" href={~p"/images/icons/favicon.png"} />
    <link rel="icon" type="image/png" sizes="192x192" href={~p"/images/icons/icon-192.png"} />
    <.live_title default="Budgeteer" suffix=" · Budgeteer" phx-no-format>{assigns[:page_title]}</.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script nonce={@csp_nonce}>
      (() => {
        const systemTheme = () => matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";

        const syncToggle = () => {
          const source = document.documentElement.getAttribute("data-theme-source");
          const active = source === "system" ? "system" : document.documentElement.getAttribute("data-theme");
          document.querySelectorAll("[data-phx-theme]").forEach((btn) => {
            btn.classList.toggle("bg-base-300", btn.dataset.phxTheme === active);
          });
        };

        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.setAttribute("data-theme", systemTheme());
            document.documentElement.setAttribute("data-theme-source", "system");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
            document.documentElement.setAttribute("data-theme-source", "user");
          }
          syncToggle();
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));
        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));
        document.addEventListener("DOMContentLoaded", syncToggle);

        matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
          if (document.documentElement.getAttribute("data-theme-source") === "system") {
            document.documentElement.setAttribute("data-theme", systemTheme());
          }
        });
      })();
    </script>
    <script nonce={@csp_nonce}>
      // iOS exposes no beforeinstallprompt-equivalent API — a PWA can never
      // trigger "Add to Home Screen" itself, so this nudges iOS visitors who
      // aren't already running standalone toward the Share-sheet action
      // manually. Dismissal is remembered so it doesn't nag every visit.
      // Also never shows inside the native iOS app shell (window.Capacitor,
      // injected by the native runtime on every page it loads, including
      // this remote site) — nudging someone to "install" a page they're
      // already viewing inside the installed app itself makes no sense.
      document.addEventListener("DOMContentLoaded", () => {
        const banner = document.getElementById("ios-install-banner");
        if (!banner) return;

        const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
        const isStandalone =
          window.navigator.standalone === true ||
          window.matchMedia("(display-mode: standalone)").matches;
        const isNativeApp = window.Capacitor?.isNativePlatform?.() === true;
        const dismissed = localStorage.getItem("budgeteer:ios-install-dismissed") === "1";

        if (isIOS && !isStandalone && !isNativeApp && !dismissed) {
          banner.classList.remove("hidden");
        }

        document.getElementById("ios-install-banner-dismiss").addEventListener("click", () => {
          localStorage.setItem("budgeteer:ios-install-dismissed", "1");
          banner.classList.add("hidden");
        });
      });
    </script>
    <script :if={@current_scope} nonce={@csp_nonce}>
      // Enrolls this device for push notifications when running inside
      // the native iOS app shell — a no-op everywhere else, since
      // window.Capacitor only exists there. Gated to a signed-in visitor
      // (@current_scope) since there's no point enrolling a token with
      // nobody to notify. Fires on every authenticated page load rather
      // than once at "install" time — the underlying call is cheap and
      // idempotent (see Households.register_device_token/3's
      // upsert-by-token), and this is simpler than tracking "have we
      // already enrolled" across app restarts/reinstalls ourselves.
      document.addEventListener("DOMContentLoaded", () => {
        const PushNotifications = window.Capacitor?.isNativePlatform?.() &&
          window.Capacitor.Plugins.PushNotifications;
        if (!PushNotifications) return;

        PushNotifications.addListener("registration", (token) => {
          fetch("/push-tokens", {
            method: "POST",
            headers: {
              "content-type": "application/json",
              "x-csrf-token": document.querySelector('meta[name="csrf-token"]').content
            },
            body: JSON.stringify({ token: token.value })
          });
        });

        PushNotifications.addListener("registrationError", (error) => {
          console.error("Push notification registration failed", error);
        });

        PushNotifications.checkPermissions().then((status) => {
          const needsPrompt = status.receive === "prompt" || status.receive === "prompt-with-rationale";
          const granted = needsPrompt ? PushNotifications.requestPermissions() : Promise.resolve(status);

          granted.then((result) => {
            if (result.receive === "granted") PushNotifications.register();
          });
        });
      });
    </script>
  </head>
  <body>
    <ul class="menu menu-horizontal w-full relative z-10 flex flex-wrap items-center gap-4 px-4 sm:px-6 lg:px-8">
      <li class="mr-auto">
        <.link href={~p"/"} class="flex items-center gap-2 !p-0">
          <.logo class="size-6 text-primary" />
          <span class="brand text-sm font-semibold">Budgeteer</span>
        </.link>
      </li>
      <%= if @current_scope do %>
        <li>
          <.link href={~p"/dashboard"}>{gettext("Dashboard")}</.link>
        </li>
        <li>
          <details>
            <summary><.icon name="hero-banknotes" /> {gettext("Finance")}</summary>
            <ul class="bg-base-100 rounded-box z-20">
              <li><.link href={~p"/accounts"}>{gettext("Accounts")}</.link></li>
              <li><.link href={~p"/transactions"}>{gettext("Search Transactions")}</.link></li>
              <li><.link href={~p"/categories"}>{gettext("Categories")}</.link></li>
              <li><.link href={~p"/subscriptions"}>{gettext("Recurring Charges")}</.link></li>
            </ul>
          </details>
        </li>
        <li>
          <details>
            <summary><.icon name="hero-home" /> {gettext("Home & Family")}</summary>
            <ul class="bg-base-100 rounded-box z-20">
              <li><.link href={~p"/groceries"}>{gettext("Groceries")}</.link></li>
              <li><.link href={~p"/todos"}>{gettext("TODOs")}</.link></li>
              <li><.link href={~p"/calendar"}>{gettext("Calendar")}</.link></li>
            </ul>
          </details>
        </li>
        <li>
          <details>
            <summary><.icon name="hero-book-open" /> {gettext("Meals")}</summary>
            <ul class="bg-base-100 rounded-box z-20">
              <li><.link href={~p"/recipes"}>{gettext("Recipes")}</.link></li>
              <li><.link href={~p"/meal-plan"}>{gettext("Meal Plan")}</.link></li>
            </ul>
          </details>
        </li>
      <% end %>
      <li>
        <div
          class="flex items-center gap-0.5 rounded-full border border-base-300 p-0.5"
          role="group"
          aria-label={gettext("Theme")}
        >
          <button
            type="button"
            phx-click={JS.dispatch("phx:set-theme")}
            data-phx-theme="system"
            class="rounded-full p-1.5 text-base-content/60 hover:text-base-content"
            aria-label={gettext("Use system theme")}
            title={gettext("System")}
          >
            <.icon name="hero-computer-desktop-micro" />
          </button>
          <button
            type="button"
            phx-click={JS.dispatch("phx:set-theme")}
            data-phx-theme="light"
            class="rounded-full p-1.5 text-base-content/60 hover:text-base-content"
            aria-label={gettext("Use light theme")}
            title={gettext("Light")}
          >
            <.icon name="hero-sun-micro" />
          </button>
          <button
            type="button"
            phx-click={JS.dispatch("phx:set-theme")}
            data-phx-theme="dark"
            class="rounded-full p-1.5 text-base-content/60 hover:text-base-content"
            aria-label={gettext("Use dark theme")}
            title={gettext("Dark")}
          >
            <.icon name="hero-moon-micro" />
          </button>
        </div>
      </li>
      <li>
        <div
          class="flex items-center gap-0.5 rounded-full border border-base-300 p-0.5"
          role="group"
          aria-label={gettext("Language")}
        >
          <.link
            href={~p"/locale/en?#{[return_to: @current_path]}"}
            class={[
              "rounded-full px-2 py-1 text-xs font-semibold text-base-content/60 hover:text-base-content",
              @locale == "en" && "bg-base-300 text-base-content"
            ]}
            aria-label={gettext("Switch to English")}
          >
            EN
          </.link>
          <.link
            href={~p"/locale/pt_PT?#{[return_to: @current_path]}"}
            class={[
              "rounded-full px-2 py-1 text-xs font-semibold text-base-content/60 hover:text-base-content",
              @locale == "pt_PT" && "bg-base-300 text-base-content"
            ]}
            aria-label={gettext("Switch to European Portuguese")}
          >
            PT
          </.link>
        </div>
      </li>
      <%= if @current_scope do %>
        <li>
          <details>
            <summary>{@current_scope.user.email}</summary>
            <ul class="bg-base-100 rounded-box z-20 right-0">
              <li><.link href={~p"/users/settings"}>{gettext("Settings")}</.link></li>
              <li>
                <.link href={~p"/users/log-out"} method="delete">{gettext("Log out")}</.link>
              </li>
            </ul>
          </details>
        </li>
      <% else %>
        <li>
          <.link href={~p"/users/register"}>{gettext("Register")}</.link>
        </li>
        <li>
          <.link href={~p"/users/log-in"}>{gettext("Log in")}</.link>
        </li>
      <% end %>
    </ul>

    <div
      :if={@current_scope}
      id="ios-install-banner"
      class="hidden fixed inset-x-0 bottom-0 z-30 p-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))]"
    >
      <div class="alert alert-info shadow-lg max-w-md mx-auto flex items-center gap-3">
        <.icon name="hero-arrow-up-on-square" class="size-5 shrink-0" />
        <span class="text-sm">
          {gettext("Install Budgeteer: tap")} <strong>{gettext("Share")}</strong>, {gettext(
            "then"
          )} <strong>{gettext("Add to Home Screen")}</strong>.
        </span>
        <button
          type="button"
          id="ios-install-banner-dismiss"
          class="btn btn-ghost btn-xs btn-circle ml-auto shrink-0"
          aria-label={gettext("Dismiss")}
        >
          <.icon name="hero-x-mark" class="size-4" />
        </button>
      </div>
    </div>

    {@inner_content}
  </body>
</html>
