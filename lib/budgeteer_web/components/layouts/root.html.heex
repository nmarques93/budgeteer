<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="theme-color" content="#1c1914" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="manifest" href={~p"/manifest.json"} />
    <link rel="apple-touch-icon" href={~p"/images/icons/apple-touch-icon.png"} />
    <link rel="icon" type="image/png" sizes="48x48" href={~p"/images/icons/favicon.png"} />
    <link rel="icon" type="image/png" sizes="192x192" href={~p"/images/icons/icon-192.png"} />
    <.live_title default="Budgeteer" suffix=" · Budgeteer" phx-no-format>{assigns[:page_title]}</.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        const systemTheme = () => matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";

        const syncToggle = () => {
          const source = document.documentElement.getAttribute("data-theme-source");
          const active = source === "system" ? "system" : document.documentElement.getAttribute("data-theme");
          document.querySelectorAll("[data-phx-theme]").forEach((btn) => {
            btn.classList.toggle("bg-base-300", btn.dataset.phxTheme === active);
          });
        };

        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.setAttribute("data-theme", systemTheme());
            document.documentElement.setAttribute("data-theme-source", "system");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
            document.documentElement.setAttribute("data-theme-source", "user");
          }
          syncToggle();
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));
        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));
        document.addEventListener("DOMContentLoaded", syncToggle);

        matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
          if (document.documentElement.getAttribute("data-theme-source") === "system") {
            document.documentElement.setAttribute("data-theme", systemTheme());
          }
        });
      })();
    </script>
  </head>
  <body>
    <ul class="menu menu-horizontal w-full relative z-10 flex flex-wrap items-center gap-4 px-4 sm:px-6 lg:px-8">
      <li>
        <div class="flex items-center gap-0.5 rounded-full border border-base-300 p-0.5" role="group" aria-label="Theme">
          <button
            type="button"
            phx-click={JS.dispatch("phx:set-theme")}
            data-phx-theme="system"
            class="rounded-full p-1.5 text-base-content/60 hover:text-base-content"
            aria-label="Use system theme"
            title="System"
          >
            <.icon name="hero-computer-desktop-micro" />
          </button>
          <button
            type="button"
            phx-click={JS.dispatch("phx:set-theme")}
            data-phx-theme="light"
            class="rounded-full p-1.5 text-base-content/60 hover:text-base-content"
            aria-label="Use light theme"
            title="Light"
          >
            <.icon name="hero-sun-micro" />
          </button>
          <button
            type="button"
            phx-click={JS.dispatch("phx:set-theme")}
            data-phx-theme="dark"
            class="rounded-full p-1.5 text-base-content/60 hover:text-base-content"
            aria-label="Use dark theme"
            title="Dark"
          >
            <.icon name="hero-moon-micro" />
          </button>
        </div>
      </li>
      <%= if @current_scope do %>
        <li class="ml-auto flex flex-row items-center gap-4">
          <.link href={~p"/dashboard"}>Dashboard</.link>
        </li>
        <li>
          <.link href={~p"/accounts"}>Accounts</.link>
        </li>
        <li>
          <.link href={~p"/categories"}>Categories</.link>
        </li>
        <li>
          <.link href={~p"/groceries"}>Groceries</.link>
        </li>
        <li>
          <details>
            <summary>More</summary>
            <ul class="bg-base-100 rounded-box z-20">
              <li><.link href={~p"/transactions"}>Search Transactions</.link></li>
              <li><.link href={~p"/recipes"}>Recipes</.link></li>
              <li><.link href={~p"/meal-plan"}>Meal Plan</.link></li>
            </ul>
          </details>
        </li>
        <li>
          <details>
            <summary>{@current_scope.user.email}</summary>
            <ul class="bg-base-100 rounded-box z-20 right-0">
              <li><.link href={~p"/users/settings"}>Settings</.link></li>
              <li><.link href={~p"/users/log-out"} method="delete">Log out</.link></li>
            </ul>
          </details>
        </li>
      <% else %>
        <li class="ml-auto flex flex-row items-center gap-4">
          <.link href={~p"/users/register"}>Register</.link>
        </li>
        <li>
          <.link href={~p"/users/log-in"}>Log in</.link>
        </li>
      <% end %>
    </ul>
    {@inner_content}
  </body>
</html>
